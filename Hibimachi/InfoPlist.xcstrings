      "comment": "App name on the Home Screen",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibimachi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひびまち"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Why the app asks for the camera",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to photograph your tasks before and after, or what you made. Photos stay on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクの前後やできたものを、写真に残すために使います。写真は端末の中だけに保存されます。"
          }
        }
      }
    }
  },
  "version": "1.0"
